/src-tauri/gen/schemas/

# Coverage artifacts (lcov from cargo-llvm-cov / vitest; uploaded to Codecov in CI)
/lcov.info
/coverage/

# mise (local state)
.mise.local.toml

# local git worktrees
/.claude/worktrees/

# Self-signed code-signing artifacts
cert-out/
*.p12
*.p12.base64

# PDFium prebuilt binaries fetched by `mise run fetch-pdfium`.
# Never committed: they are large, platform-specific, and reproducibly
# re-fetched from a pinned version with SHA-256 verification.
/src-tauri/resources/pdfium/
